# Twilio Voice & SMS Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VALIDATE_SIGNATURE=false

# AI Services
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Business Defaults
BUSINESS_NAME=Smiles Dental Clinic
BUSINESS_TYPE=dental
BUSINESS_LOCATION=BGC, Taguig City, Philippines
BUSINESS_HOURS=Mon-Sat: 9:00 AM - 6:00 PM, Sun: Closed
BUSINESS_PHONE=+639171234567
OWNER_PHONE_NUMBER=+639171234567

# Google Integrations
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=your_sheet_id_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
